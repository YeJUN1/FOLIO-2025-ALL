.login
    .content
        width 420px

        @media only screen and (max-width 520px)
            width calc(100vw - 40px)

        .title
            font-size 34px
            font-weight 900
            text-align center

        .subtitle
            margin-top 6px
            margin-bottom 26px
            text-align center
            font-size 15px
            opacity 0.75

            strong
                color #ffd000

        .field
            display block
            margin-bottom 16px

            .label
                display block
                margin-bottom 6px
                font-size 13px
                letter-spacing 1px
                text-transform uppercase
                opacity 0.6

            .input
                width 100%
                height 52px
                padding 0 16px
                border 1px solid alpha(#ffffff, 0.35)
                border-radius 8px
                background alpha(#ffffff, 0.06)
                color #ffffff

                &::placeholder
                    color alpha(#ffffff, 0.35)

                &:focus
                    outline none
                    border-color #ffd000
                    background alpha(#ffffff, 0.1)

        .message
            min-height 22px
            margin-bottom 14px
            font-size 14px
            opacity 0.85

            &.is-error
                color #ff7b7b

            &.is-success
                color #7bff9b

        .buttons
            display flex
            gap 12px

            .button
                flex 1
                text-align center

                &.is-secondary
                    border-color alpha(#ffffff, 0.35)
                    opacity 0.75

                    html:not(.is-mode-touch) &:hover
                        opacity 1

        .hint
            margin-top 14px
            font-size 13px
            text-align center
            opacity 0.5

        .login-form
            &.is-hidden
                display none

            &.is-disabled
                pointer-events none
                opacity 0.6

        .profile
            display none
            text-align center

            &.is-visible
                display block

            .profile-name
                font-size 30px
                font-weight 900
                margin-bottom 8px

            .profile-points
                font-size 22px
                font-weight 700
                color #ffd000
                margin-bottom 12px

            .profile-territory
                font-size 14px
                opacity 0.7
                margin-bottom 24px

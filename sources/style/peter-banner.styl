.peter-banner
    position absolute
    z-index 8
    top 18px
    left 16px
    max-width 260px
    padding 10px 16px 12px
    pointer-events none
    -webkit-user-select none
    -moz-user-select none
    user-select none
    color #fff7ea
    background radial-gradient(ellipse at top left, #6b2430, #1d1721 72%)
    box-shadow 0 10px 28px rgba(0, 0, 0, 0.28)

    @media only screen and (max-width 520px)
        top 12px
        left 12px
        padding 8px 12px 10px

    .kicker
        font-family "Nunito", sans-serif
        font-size 11px
        font-weight 700
        letter-spacing 0.14em
        text-transform uppercase
        color #e6b35a

    .name
        margin-top 1px
        font-family "Amatic SC", sans-serif
        font-weight 700
        font-size 36px
        line-height 0.9

        @media only screen and (max-width 520px)
            font-size 30px

    .handle
        margin-top 2px
        font-family "Nunito", sans-serif
        font-size 13px
        font-weight 700
        opacity 0.88
